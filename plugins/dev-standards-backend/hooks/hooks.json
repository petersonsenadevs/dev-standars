{
    "hooks":  {
                  "SessionStart":  [
                                       {
                                           "hooks":  [
                                                         {
                                                             "type":  "command",
                                                             "command":  "powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.ps1\"",
                                                             "timeout":  30
                                                         }
                                                     ]
                                       }
                                   ],
                  "UserPromptSubmit":  [
                                           {
                                               "hooks":  [
                                                             {
                                                                 "type":  "command",
                                                                 "command":  "powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/hooks/prompt-router.ps1\"",
                                                                 "timeout":  30
                                                             }
                                                         ]
                                           }
                                       ],
                  "PreToolUse":  [
                                     {
                                         "matcher":  "Bash|PowerShell",
                                         "hooks":  [
                                                       {
                                                           "type":  "command",
                                                           "command":  "powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.ps1\"",
                                                           "timeout":  30
                                                       }
                                                   ]
                                     },
                                     {
                                         "matcher":  "Edit|Write|MultiEdit|NotebookEdit",
                                         "hooks":  [
                                                       {
                                                           "type":  "command",
                                                           "command":  "powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/hooks/protect-files.ps1\"",
                                                           "timeout":  30
                                                       },
                                                       {
                                                           "type":  "command",
                                                           "command":  "powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/hooks/secrets-guard.ps1\"",
                                                           "timeout":  30
                                                       }
                                                   ]
                                     }
                                 ],
                  "PostToolUse":  [
                                      {
                                          "matcher":  "Edit|Write|MultiEdit",
                                          "hooks":  [
                                                        {
                                                            "type":  "command",
                                                            "command":  "powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/hooks/format-on-save.ps1\"",
                                                            "timeout":  30
                                                        },
                                                        {
                                                            "type":  "command",
                                                            "command":  "powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/hooks/edit-tracker.ps1\"",
                                                            "timeout":  30
                                                        }
                                                    ]
                                      }
                                  ],
                  "Stop":  [
                               {
                                   "hooks":  [
                                                 {
                                                     "type":  "command",
                                                     "command":  "powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/hooks/stop-guard.ps1\"",
                                                     "timeout":  30
                                                 }
                                             ]
                               }
                           ],
                  "PreCompact":  [
                                     {
                                         "hooks":  [
                                                       {
                                                           "type":  "command",
                                                           "command":  "powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/hooks/pre-compact.ps1\"",
                                                           "timeout":  30
                                                       }
                                                   ]
                                     }
                                 ],
                  "SessionEnd":  [
                                     {
                                         "hooks":  [
                                                       {
                                                           "type":  "command",
                                                           "command":  "powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/hooks/session-end.ps1\"",
                                                           "timeout":  5
                                                       }
                                                   ]
                                     }
                                 ]
              }
}