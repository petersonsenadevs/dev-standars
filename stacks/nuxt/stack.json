{
  "name": "nuxt",
  "label": "Nuxt 3/4 + Vue 3",
  "extends": "core",
  "language": "typescript",
  "systemprompt": "systemprompt.md",
  "bestPractices": "best-practices.md",
  "prohibited": "prohibited.md",
  "mcp": "mcp.json",
  "skills": [
    "../../core/skills/devlog",
    "project-planner",
    "code-quality",
    "backend-audit",
    "depurar",
    "skill-router",
    "instalar-proyecto",
    "deploy-ops",
    "front-activation",
    "ui-ux-pro-max",
    "ui-verify",
    "image-gen",
    "marketing-seo",
    "email-html",
    "skills"
  ],
  "frontProfile": {
    "label": "Nuxt 3 + Vue 3 + Tailwind",
    "stacks": [
      "nuxtjs",
      "vue",
      "shadcn",
      "html-tailwind"
    ]
  },
  "optionalBundles": [
    "core-3d-animation",
    "extended-3d-scroll",
    "animation-components",
    "3d-authoring",
    "web-design-meta",
    "design-extras",
    "architecture"
  ],
  "settingsPartial": "settings.partial.json",
  "commands": {
    "lint": "npm run lint",
    "types": "npx nuxi typecheck",
    "test": "npm test",
    "build": "npm run build",
    "dev": "npm run dev"
  },
  "formatters": {
    ".vue": "npx prettier --write {file}",
    ".ts": "npx prettier --write {file}",
    ".js": "npx prettier --write {file}",
    ".css": "npx prettier --write {file}"
  },
  "protectedPaths": [
    "composer.lock",
    "package-lock.json",
    "pnpm-lock.yaml",
    "yarn.lock",
    ".github/workflows/**"
  ]
}
